# The server reads process environment only; it does not load this file.
# Without database configuration only health routes are enabled.
# Set a loopback PostgreSQL URL privately, then run operator migrations.
# KANCHE_DATABASE_URL=
# Set the canonical HTTPS origin (loopback HTTP allowed for development)
# to enable hosted routes. See docs/contracts/hosted-integration.md.
# KANCHE_HOSTED_ORIGIN=http://127.0.0.1:8080
KANCHE_BIND_ADDR=127.0.0.1:8080
KANCHE_LOG_LEVEL=info
