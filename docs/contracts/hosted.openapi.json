                  "description": "No scripts/assets; default-src 'none'; frame-ancestors 'none'; base-uri 'none'. Validated form/retry documents use form-action 'self' plus the exact current registered callback source/path, safely encoded. Other errors/303 may use self only."
                }
              },
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "403": {
            "description": "Invalid browser nonce, CSRF or Origin; safe restart HTML",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Referrer-Policy": {
                "schema": {
                  "const": "same-origin"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "const": "nosniff"
                }
              },
              "Content-Security-Policy": {
                "schema": {
                  "type": "string",
                  "description": "No scripts/assets; default-src 'none'; frame-ancestors 'none'; base-uri 'none'. Validated form/retry documents use form-action 'self' plus the exact current registered callback source/path, safely encoded. Other errors/303 may use self only."
                }
              }
            },
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tenant_id": {
            "type": "string",
            "minLength": 1
          },
          "application_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "tenant_id", "application_id"]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "format": {
            "type": "string",
            "const": "opaque"
          },
          "idle_expires_at": {
            "type": "integer",
            "format": "int64",
            "description": "Exclusive Unix seconds idle deadline"
          },
          "absolute_expires_at": {
            "type": "integer",
            "format": "int64",
            "description": "Exclusive Unix seconds maximum lifetime deadline"
          }
        },
        "required": ["format", "idle_expires_at", "absolute_expires_at"]
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "const": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["type", "title", "status", "code", "request_id"]
      },
      "IssuedSession": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "format": {
            "type": "string",
            "const": "opaque"
          },
          "idle_expires_at": {
            "type": "integer",
            "format": "int64",
            "description": "Exclusive Unix seconds idle deadline"
          },
          "absolute_expires_at": {
            "type": "integer",
            "format": "int64",
            "description": "Exclusive Unix seconds maximum lifetime deadline"
          },
          "credential": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Server-only bearer; never render or log"
          }
        },
        "required": [
          "format",
          "idle_expires_at",
          "absolute_expires_at",
          "credential"
        ]
      },
      "Grant": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "session": {
            "$ref": "#/components/schemas/IssuedSession"
          }
        },
        "required": ["user", "session"]
      },
      "CreateHosted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "redirect_uri": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "Exact operator-registered callback; no query, fragment, userinfo or noncanonical encoding. HTTPS except explicitly registered loopback development."
          },
          "state": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "code_challenge": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "code_challenge_method": {
            "type": "string",
            "const": "S256"
          }
        },
        "required": [
          "redirect_uri",
          "state",
          "code_challenge",
          "code_challenge_method"
        ]
      },
      "HostedTransaction": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "authorization_url": {
            "type": "string",
            "format": "uri",
            "description": "Canonical hosted origin /hosted/login with one transaction parameter, never an app secret/session credential"
          },
          "expires_at": {
            "type": "integer",
            "format": "int64",
            "description": "Exclusive DB Unix-second deadline; five-minute lifetime"
          }
        },
        "required": ["authorization_url", "expires_at"]
      },
      "ExchangeHosted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "code_verifier": {
            "type": "string",
            "minLength": 43,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._~-]+$",
            "writeOnly": true
          },
          "redirect_uri": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "Exact operator-registered callback; no query, fragment, userinfo or noncanonical encoding. HTTPS except explicitly registered loopback development."
          }
        },
        "required": ["code", "code_verifier", "redirect_uri"]
      },
      "HostedPassword": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "transaction": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "csrf_token": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true,
            "description": "UTF-8 byte ceiling128; never silently normalized/truncated"
          }
        },
        "required": ["transaction", "csrf_token", "email", "password"]
      }
    },
    "securitySchemes": {
      "ApplicationSecret": {
        "type": "http",
        "scheme": "bearer",
        "description": "App authority, separate from session credential"
      }
    }
  }
}
